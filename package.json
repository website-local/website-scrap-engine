{
  "name": "website-scrap-engine",
  "version": "0.10.0",
  "description": "Configurable website scraper in typescript",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{force:true,recursive:true})\"",
    "tsc": "tsc",
    "lint": "eslint --fix src test",
    "test": "npm run lint && npm run check:tests && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "npm run lint && npm run tsc && npm run copy",
    "copy": "node copy-src.js",
    "prepack": "npm run clean && npm run build",
    "postshrinkwrap": "node package-lock-resolved.js",
    "check:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "got": "^16.0.0",
    "p-queue": "^9.3.3",
    "srcset": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "log4js": "^6.9.1"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "brace-expansion": "5.0.12",
    "js-yaml": "3.15.2",
    "minimatch": "10.2.5",
    "test-exclude": "7.0.2",
    "undici": "npm:@favware/skip-dependency@1.2.2"
  },
  "files": [
    ".editorconfig",
    "tsconfig.json",
    "fake-undici.d.ts",
    "lib",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/website-local/website-scrap-engine.git"
  },
  "keywords": [
    "typescript",
    "website",
    "scraper",
    "download"
  ],
  "author": "myfreeer",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/website-local/website-scrap-engine/issues"
  },
  "homepage": "https://github.com/website-local/website-scrap-engine#readme",
  "peerDependencies": {
    "log4js": "^6.9.1"
  },
  "peerDependenciesMeta": {
    "log4js": {
      "optional": true
    }
  }
}
