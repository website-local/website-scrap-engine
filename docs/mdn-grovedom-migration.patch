+
+const require = createRequire(import.meta.url);
+const parser = require('../owned-parser.cjs') as {
+  state: {documents: {closed: boolean; disposals: number}[]};
+};
+
+test('submits detached processed HTML before the parent document scope closes', async () => {
+  parser.state.documents.length = 0;
+  const lc = lifeCycle.defaultLifeCycle();
+  lc.processAfterDownload.push(res => {
+    res.meta.doc?.('body').attr('data-processed', 'yes');
+    return res;
+  });
