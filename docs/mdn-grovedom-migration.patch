+import type {HtmlParserOptions} from 'website-scrap-engine';
+import {
+  mergeSamples, mergeSamplesWithHtmlParser
+} from '../../src/mdn/mdn-merge-samples.js';
+
+const require = createRequire(import.meta.url);
+const parser = require('./owned-parser.cjs') as {
+  state: {documents: {closed: boolean; disposals: number}[]};
+};
+const parserOptions: HtmlParserOptions = {
+  htmlParser: 'grovedom',
+  grovedom: {module: pathToFileURL(require.resolve('./owned-parser.cjs')).href},
+};
+let root: string;
+
+const write = async (relative: string, content: string): Promise<void> => {
+  const file = path.join(root, relative);
+  await fs.mkdir(path.dirname(file), {recursive: true});
+  await fs.writeFile(file, content);
+};
+
+beforeEach(async () => {
+  parser.state.documents.length = 0;
+  root = await fs.mkdtemp(path.join(tmpdir(), 'mdn-merge-ownership-'));
+});
+afterEach(async () => { await fs.rm(root, {recursive: true, force: true}); });
+
+describe('standalone sample parser ownership', () => {
+  test.each([false, true])('copies samples and asset bytes (deferred parse: %s)', async large => {
+    const html = '<body><img src="asset.bin#part"><p>Sample</p></body>' +
+      (large ? '<!--' + 'x'.repeat(700) + '-->' : '');
+    await write('english/en-US/docs/topic/$samples/sample.html', html);
+    await write('english/en-US/docs/topic/$samples/asset.bin', 'asset bytes');
+    await write('chinese/zh-CN/docs/placeholder/$samples/empty.html', '<body></body>');
+    await mergeSamplesWithHtmlParser(parserOptions,
+      path.join(root, 'english'), path.join(root, 'chinese'));
+    expect(await fs.readFile(path.join(root,
+      'chinese/zh-CN/docs/topic/$samples/sample.html'), 'utf8')).toBe(html);
+    expect(await fs.readFile(path.join(root,
+      'chinese/zh-CN/docs/topic/$samples/asset.bin'), 'utf8')).toBe('asset bytes');
+    expect(parser.state.documents).toHaveLength(2);
+    expect(parser.state.documents.every(row => row.closed && row.disposals === 1)).toBe(true);
+  });
+
+  test('finishes every document scope before rejecting a concurrent batch', async () => {
+    await write('english/en-US/docs/topic/$samples/failure.html',
+      '<body data-parser-failure>bad</body>');
+    await write('english/en-US/docs/topic/$samples/ok.html', '<body>good</body>');
+    await expect(mergeSamplesWithHtmlParser(parserOptions,
+      path.join(root, 'english'))).rejects.toThrow('Injected parser failure');
+    expect(parser.state.documents).toHaveLength(2);
+    expect(parser.state.documents.every(row => row.closed && row.disposals === 1)).toBe(true);
+  });
+
+  test('preserves the default Cheerio entry point', async () => {
+    await write('english/en-US/docs/topic/$samples/sample.html', '<body>Sample</body>');
+    await mergeSamples(path.join(root, 'english'));
+    expect(parser.state.documents).toHaveLength(0);
+  });
+});
diff --git a/test/mdn/owned-parser.cjs b/test/mdn/owned-parser.cjs
new file mode 100755
index 0000000..c9e80c7
--- /dev/null
+++ b/test/mdn/owned-parser.cjs
@@ -0,0 +1,24 @@
+const {load} = require('cheerio');
+
+const state = {documents: []};
+exports.state = state;
+exports.init = () => {};
+exports.load = (...args) => {
+  const doc = load(...args);
+  const row = {closed: false, disposals: 0};
+  state.documents.push(row);
+  const html = doc.html.bind(doc);
+  doc.html = (...args) => {
+    if (row.closed) throw new Error('Document is disposed');
+    return html(...args);
+  };
+  doc.dispose = () => { row.closed = true; row.disposals++; };
+  return new Proxy(doc, {
+    apply(target, self, values) {
+      if (String(args[0]).includes('data-parser-failure') && values[0] === 'body') {
+        throw new Error('Injected parser failure');
+      }
+      return Reflect.apply(target, self, values);
+    },
+  });
+};
