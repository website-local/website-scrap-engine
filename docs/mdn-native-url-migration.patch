   public preferIpv6 = false;

+  readonly nativeLookup: LookupFunction = (hostname, options, callback) => {
+    const family = options.family;
+    if (family !== undefined && family !== 0 && family !== 4 && family !== 6) {
+      callback(Object.assign(new Error('Unsupported address family'),
+        {code: 'EINVAL'}), '', 0);
+      return;
+    }
+    this.lookupAsync(hostname, {
+      hints: options.hints, family: family || undefined, all: true
+    }).then(entries => {
+      if (options.all) callback(null, [...entries]);
+      else callback(null, entries[0].address, entries[0].family);
+    }, error => callback(error, '', 0));
+  };
+
   constructor(options?: Options) {
     super(options);
   }
