    "unmitigatedRequests": 1,
    "secondResponseFromCache": true,
    "secondResponseBody": "alice secret",
    "secondResponseSetCookie": [
      "session=alice"
    ],
    "regressionWithoutGuard": "Buffered and streaming leak tests both fail by returning alice instead of anonymous."
